d","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"toolbarVerticalBehavior"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"behavior"},{"kind":"text","text":": "},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/ToolbarVerticalBehavior","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI23ToolbarVerticalBehaviorV","text":"ToolbarVerticalBehavior"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP","text":"View"},{"kind":"text","text":"\n"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The desired behavior for the vertical bar.","type":"text"}],"type":"paragraph"}],"name":"behavior"}]},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"By default, the system determines whether a vertical bar is rendered","type":"text"},{"text":" ","type":"text"},{"text":"based on the device and application state. Use","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/ToolbarVerticalBehavior\/disabled","isActive":true,"type":"reference"},{"text":" to opt out of the vertical bar,","type":"text"},{"text":" ","type":"text"},{"text":"causing bar content to fall back to the standard horizontal top and","type":"text"},{"text":" ","type":"text"},{"text":"bottom toolbars.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Disable the vertical bar only for UIs that are better served by","type":"text"},{"text":" ","type":"text"},{"text":"horizontal bars — such as a fullscreen video player with toolbar","type":"text"},{"text":" ","type":"text"},{"text":"controls, or a non-scrolling layout like a calculator where horizontal","type":"text"},{"text":" ","type":"text"},{"text":"space is at a premium. Treat it as a stable choice: avoid changing it","type":"text"},{"text":" ","type":"text"},{"text":"frequently as the user navigates, and don’t toggle it for a single view","type":"text"},{"text":" ","type":"text"},{"text":"as a function of that view’s state. To hide the bars on a given screen","type":"text"},{"text":" ","type":"text"},{"text":"rather than change the layout, use ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/View\/toolbarVisibility(_:for:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The behavior is resolved by the window or presentation if placed within","type":"text"},{"text":" ","type":"text"},{"text":"a sheet or form. Different containers resolve their overall preferred","type":"text"},{"text":" ","type":"text"},{"text":"behavior in different ways:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/NavigationStack","isActive":true,"type":"reference"},{"text":" uses the top most view of its stack of views.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/TabView","isActive":true,"type":"reference"},{"text":" uses the selected view.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/NavigationSplitView","isActive":true,"type":"reference"},{"text":" uses the view in the trailing-most column.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"When the value changes, the system animates the transition: content reflows","type":"text"},{"text":" ","type":"text"},{"text":"to or from the horizontal bars while the status bar changes axis and","type":"text"},{"text":" ","type":"text"},{"text":"the leading or trailing safe area inset for the vertical bar is added","type":"text"},{"text":" ","type":"text"},{"text":"or removed.","type":"text"}],"type":"paragraph"},{"code":["TabView {","    Tab(\"Home\", systemImage: \"house\") {","        HomeView()","    }","}",".toolbarVerticalBehavior(.disabled)"],"copyToClipboard":true,"lineAnnotations":[],"showLineNumbers":false,"syntax":"swift","type":"codeListing","wrap":0}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Configuring-vertical-toolbar-behavior","generated":true,"identifiers":["doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/ToolbarVerticalBehavior","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/View\/toolbarVerticalCompressionBehavior(_:)","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/ToolbarVerticalCompressionBehavior"],"title":"Configuring vertical toolbar behavior"}],"variants":[{"paths":["\/documentation\/swiftui\/view\/toolbarverticalbehavior(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"SwiftUI-PageImage-card.png":{"alt":"A stylized Swift logo using dashes on a white or blue background.","identifier":"SwiftUI-PageImage-card.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.SwiftUI\/SwiftUI-PageImage-card@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.SwiftUI\/SwiftUI-PageImage-card~dark@2x.png"}]},"doc://com.apple.SwiftUI/documentation/SwiftUI":{"abstract":[{"text":"Declare the user interface and behavior for your app on every platform.","type":"text"}],"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI","images":[{"identifier":"SwiftUI-PageImage-card.png","type":"card"}],"kind":"symbol","role":"collection","title":"SwiftUI","type":"topic","url":"\/documentation\/swiftui"},"doc://com.apple.SwiftUI/documentation/SwiftUI/Navi